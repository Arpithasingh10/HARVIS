# --- App ---
APP_ENV=development
APP_NAME=HARVIS

# --- PostgreSQL ---
# For early local dev, SQLite is acceptable — set DATABASE_URL to sqlite:///./harvis.db
DATABASE_URL=postgresql://harvis_user:harvis_password@localhost:5432/harvis_db

# --- ChromaDB (local persistence, no server required for now) ---
CHROMA_PERSIST_DIR=./rag/chroma_data

# --- Embedding model ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- LLM (fill in once decided at Phase 4) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL_NAME=
